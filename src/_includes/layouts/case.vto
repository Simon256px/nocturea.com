---
layout: layouts/base.vto
---
{{# The matting colour, frame border and shadow are per project — see the
    `stage` object in src/_data/projects.js. They ride in as custom
    properties so the CSS stays in global.css. #}}
{{ set stage = `--stage-bg:${project.stage.bg}; --stage-shadow:${project.stage.shadow}; --stage-border:${project.stage.border}` }}

<section class="noc-wrap noc-case-back">
  <a href="/work.html" class="noc-back">← Work</a>
</section>

<section class="noc-wrap noc-case-head noc-rule-bottom">
  <h1 class="noc-h1 noc-h1--case">{{ project.name }}</h1>
  <div class="noc-case-meta">
    <div>
      <span class="noc-kicker">Client</span>
      <p class="noc-case-meta__value">{{ project.client }}</p>
    </div>
    <div>
      <span class="noc-kicker">Scope</span>
      <p class="noc-case-meta__value">{{ project.kind }}</p>
    </div>
    <div>
      <span class="noc-kicker">Year</span>
      <p class="noc-case-meta__value">{{ project.year }}</p>
    </div>
    {{# Duration is optional. A festival site has no mission length worth
        stating, and a fourth cell holding a stand-in reads worse than three. #}}
    {{- if project.duration }}
    <div>
      <span class="noc-kicker">Duration</span>
      <p class="noc-case-meta__value">{{ project.duration }}</p>
    </div>
    {{- /if }}
  </div>
</section>

{{# `framed` is false for photography and garment mockups: a window chrome
    around a photograph would claim it is a screenshot. #}}
<section class="noc-wrap noc-case-hero">
  <div class="noc-stage" style="{{ stage }}">
    {{- if project.framed }}
    <div class="noc-frame noc-frame--hero">
      <div class="noc-frame__bar">
        <span class="noc-frame__dot"></span>
        <span class="noc-frame__dot"></span>
        <span class="noc-frame__dot"></span>
        <span class="noc-frame__url">{{ project.hero.url }}</span>
      </div>
      <img src="{{ project.hero.src }}" width="{{ project.hero.w }}" height="{{ project.hero.h }}"
           alt="{{ project.name }} — {{ project.hero.url }}" fetchpriority="high" />
    </div>
    {{- else }}
    <img class="noc-plate noc-plate--hero" src="{{ project.hero.src }}"
         width="{{ project.hero.w }}" height="{{ project.hero.h }}"
         alt="{{ project.name }} — {{ project.hero.alt }}" fetchpriority="high" />
    {{- /if }}
  </div>
</section>

<section class="noc-wrap noc-section noc-split noc-reveal">
  <h2 class="noc-label">The context</h2>
  <p class="noc-statement">{{ project.context }}</p>
</section>

<section class="noc-wrap noc-section--flush-top noc-grid-2 noc-reveal">
  {{- for tile of project.tiles }}
  <figure class="noc-figure" style="{{ stage }}">
    <div class="noc-stage noc-stage--tile" style="--stage-bg:{{ tile.bg }}">
      <img src="{{ tile.src }}" width="{{ tile.w }}" height="{{ tile.h }}"
           alt="{{ project.name }} — {{ tile.label }}" loading="lazy" class="noc-tile-img" />
    </div>
    <figcaption>{{ tile.label }}</figcaption>
  </figure>
  {{- /for }}
</section>

<section class="noc-rule-top noc-reveal">
  <div class="noc-wrap noc-section">
    <h2 class="noc-label noc-label--spaced">The reasoning</h2>
    {{- for reason of project.reasons }}
    <div class="noc-reason">
      <div>
        <span class="noc-num noc-reason__num">{{ reason.num }}</span>
        <h3 class="noc-h3">{{ reason.title }}</h3>
      </div>
      <p class="noc-prose">{{ reason.body }}</p>
    </div>
    {{- /for }}
  </div>
</section>

<section class="noc-wrap noc-section--flush-top noc-reveal">
  <div class="noc-gallery{{ if project.galleryWide }} noc-gallery--single{{ /if }}">
    {{- for item of project.gallery }}
    <figure class="noc-figure{{ if item.raised }} noc-figure--raised{{ /if }}" style="{{ stage }}">
      <div class="noc-stage" style="--stage-bg:{{ item.bg }}">
        {{- if item.framed }}
        <div class="noc-frame">
          <div class="noc-frame__bar">
            <span class="noc-frame__dot"></span>
            <span class="noc-frame__dot"></span>
            <span class="noc-frame__dot"></span>
            <span class="noc-frame__url">{{ item.url }}</span>
          </div>
          <img src="{{ item.src }}" width="{{ item.w }}" height="{{ item.h }}"
               alt="{{ project.name }} — {{ item.label }}" loading="lazy" />
        </div>
        {{- else }}
        <img class="noc-plate" src="{{ item.src }}" width="{{ item.w }}" height="{{ item.h }}"
             alt="{{ project.name }} — {{ item.label }}" loading="lazy" />
        {{- /if }}
      </div>
      <figcaption>{{ item.label }}</figcaption>
    </figure>
    {{- /for }}
  </div>
</section>

<section class="noc-rule-top noc-reveal">
  <div class="noc-wrap noc-section noc-split">
    <h2 class="noc-label">What shipped</h2>
    <div class="noc-deliverables">
      {{- for deliverable of project.deliverables }}
      <div class="noc-deliverable">
        <span class="noc-deliverable__num">{{ deliverable.num }}</span>
        <span>{{ deliverable.label }}</span>
      </div>
      {{- /for }}
    </div>
  </div>
</section>

<section class="noc-rule-top noc-reveal">
  <div class="noc-wrap noc-next">
    <div>
      <span class="noc-kicker">Next project</span>
      <p class="noc-next__name">{{ project.nextName }}</p>
    </div>
    <a href="{{ project.nextUrl }}" class="noc-btn noc-btn--outline">Open</a>
  </div>
</section>
